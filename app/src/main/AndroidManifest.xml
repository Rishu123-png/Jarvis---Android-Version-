<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Read-only network state for the system telemetry panel. Normal permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Network access is used for exactly one thing: sending a request to the AI provider whose key
      the operator stored in Settings. There is no JARVIS backend and no analytics. If no key is
      configured, no request is ever made.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Triggered automation.

      RECEIVE_BOOT_COMPLETED: alarms and the watcher do not survive a reboot; this re-arms them.
      FOREGROUND_SERVICE(+_SPECIAL_USE): armed automation watches state that Android only reports to
      a running process, so it runs as a foreground service with a visible, quiet notification.
      POST_NOTIFICATIONS: required to show that notification on Android 13+.
      SCHEDULE_EXACT_ALARM: time triggers fire on the minute only if the operator allows it; without
      it JARVIS falls back to an inexact alarm and says so in the UI.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      Notification policy access.

      This is the only way an ordinary app may set the Do Not Disturb state directly. It is a
      special app access (Settings -> Notifications -> Do Not Disturb access), the operator grants it
      explicitly, and without it JARVIS falls back to opening the system screen and saying so.
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!--
      Voice module.

      RECORD_AUDIO is requested only when the operator taps the orb for the first time — never at
      launch. Audio is either transcribed on this device by the system recognizer, or sent to the AI
      provider whose key the operator stored, and is never kept after the sentence is converted.

      READ_CONTACTS turns a spoken name ("dad", "Divik") into a number. CALL_PHONE places the call
      directly; without it JARVIS opens the dialer with the number filled in and says so.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!--
      Camera.

      Used by exactly one action — "take a photo" — and by nothing in the background. The capture
      activity is shown for about a second, takes one frame, writes it to Pictures/JARVIS and
      finishes. A spoken chain such as "open camera, capture, show it" then opens the newest file.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Floating bubble (opt-in). SYSTEM_ALERT_WINDOW is a special app access: the operator grants it in
      system settings and can revoke it at any time, in which case the bubble service shuts itself
      down instead of running invisibly.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      Biometric unlock for the privacy lock.

      A normal permission: it grants the right to *ask* the system to authenticate. No biometric data
      reaches the app — Android compares in its own secure hardware and returns only a pass/fail.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      Shizuku (optional).

      `moe.shizuku.manager.permission.API_V23` and the `<meta-data>` marker below are contributed by
      the dev.rikka.shizuku:provider artifact's own manifest, so they are not repeated here. The
      <provider> entry is required: it is how the Shizuku binder is delivered to this app.
    -->

    <!--
      Package visibility (Android 11+).
      Without this block, queryIntentActivities() silently returns an empty list on targetSdk 30+
      and the app drawer looks broken. Declaring the intents we query is the supported way to
      see other launchers' activities.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Android 11+ package visibility: needed to report whether Shizuku is installed. -->
        <package android:name="moe.shizuku.manager" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jarvis">

        <!--
          MainActivity is both the normal app entry point (LAUNCHER) and a candidate Home app
          (HOME + DEFAULT). Behaviour as a launcher:
            * stateNotNeeded -> the system can restart it without a saved instance state
            * singleTask      -> pressing Home repeatedly reuses one task instead of stacking
            * excludeFromRecents -> a Home app should not appear in the recents switcher
          JARVIS is never made the default Home app automatically; the user opts in from
          Settings inside the app.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.Jarvis"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="LockedOrientationActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Notification listener.

          Android only binds this service after the user explicitly enables JARVIS under
          Settings -> Notification access. It is never bound implicitly, holds no data on disk, and
          is the same mechanism smartwatches and car integrations use.
        -->
        <service
            android:name=".device.JarvisNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Automation accessibility service.

          Inert until the user enables JARVIS under Settings -> Accessibility, and even then its only
          capabilities are navigation gestures and pressing a control by exact label (that second
          tier needs a separate in-app opt-in). onAccessibilityEvent is intentionally empty: no
          background screen reading.
        -->
        <!-- Watches state triggers only while automation is armed. -->
        <service
            android:name=".automation.AutomationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Operator-armed automation triggers" />
        </service>

        <!-- One-shot time triggers. Not exported: only the AlarmManager fires this. -->
        <receiver
            android:name=".automation.AutomationAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.jarvis.assistant.action.FIRE_ROUTINE" />
            </intent-filter>
        </receiver>

        <!-- The floating bubble. Foreground, so it cannot be killed silently mid-session. -->
        <service
            android:name=".device.BubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Operator-enabled floating shortcut to the voice surface" />
        </service>

        <!-- Home-screen widget: a live 12-hour clock that opens JARVIS ready to listen. -->
        <receiver
            android:name=".device.JarvisWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!--
          Quick Settings tiles: open JARVIS, and the torch.

          `BIND_QUICK_SETTINGS_TILE` is a system-only permission, so nothing else can bind to these,
          and each tile does one thing with no hidden state.
        -->
        <service
            android:name=".device.JarvisTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="JARVIS"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".device.TorchTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="JARVIS Torch"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- One-shot reminders. Not exported: only the AlarmManager fires this. -->
        <receiver
            android:name=".device.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.jarvis.assistant.action.FIRE_REMINDER" />
            </intent-filter>
        </receiver>

        <!-- Re-arms alarms and the watcher after a reboot or an app update. -->
        <receiver
            android:name=".automation.AutomationBootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".automation.JarvisAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          Shizuku binder provider.

          A ContentProvider (not a service) because that is how the Shizuku library hands over its
          binder. `android:permission` is a signature permission held only by the system, so no other
          ordinary app can query it. If Shizuku is not installed this provider simply never answers;
          nothing else in the app depends on it being alive.
        -->
        <!--
          Camera capture surface. Framework theme on purpose: no Compose or AppCompat dependency, so
          this window cannot fail to inflate. It is excluded from recents and never kept alive.
        -->
        <activity
            android:name=".device.CaptureActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            tools:ignore="LockedOrientationActivity" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>
